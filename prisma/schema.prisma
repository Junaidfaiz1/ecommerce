// VORQEN — Phase 2 full commerce + hardware schema
// Compatibility-critical specs are typed columns (not JSON-only).

generator client {
  provider = "prisma-client"
  output   = "../apps/web/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
  SUPPORT
}

enum AddressType {
  SHIPPING
  BILLING
  BOTH
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  CPU
  GPU
  MOTHERBOARD
  RAM
  STORAGE
  PSU
  CASE
  COOLER
  ACCESSORY
  OTHER
}

enum ComponentSlot {
  CPU
  GPU
  MOTHERBOARD
  RAM
  STORAGE
  PSU
  CASE
  COOLER
}

enum CompatibilitySeverity {
  ERROR
  WARNING
}

enum BuildVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  STRIPE
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum InventoryTxnType {
  STOCK_IN
  STOCK_OUT
  RESERVE
  RELEASE
  ADJUSTMENT
  SALE
  RETURN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AbandonedCartStatus {
  ACTIVE
  EMAIL_SENT
  CLICKED
  RECOVERED
  EXPIRED
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum GraphicsQuality {
  LOW
  MEDIUM
  HIGH
  ULTRA
}

enum StorageInterface {
  NVME_M2
  SATA_SSD
  SATA_HDD
  OTHER
}

enum CoolerType {
  AIR
  AIO_LIQUID
  CUSTOM_LOOP
}

enum AuthChallengePurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  role            UserRole  @default(CUSTOMER)
  emailVerifiedAt DateTime? @map("email_verified_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  addresses           Address[]
  builds              PCBuild[]
  cart                Cart?
  wishlist            Wishlist?
  orders              Order[]
  reviews             Review[]
  couponUsages        CouponUsage[]
  notifications       Notification[]
  auditLogs           AuditLog[]              @relation("AuditActor")
  abandonedCarts      AbandonedCart[]
  inventoryTxns       InventoryTransaction[]  @relation("InventoryTxnActor")
  refreshTokens       RefreshToken[]
  authChallenges      AuthChallenge[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent") @db.VarChar(512)
  ip        String?   @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuthChallenge {
  id        String               @id @default(cuid())
  userId    String               @map("user_id")
  purpose   AuthChallengePurpose
  tokenHash String               @unique @map("token_hash")
  expiresAt DateTime             @map("expires_at")
  usedAt    DateTime?            @map("used_at")
  createdAt DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_challenges")
}

model Address {
  id         String      @id @default(cuid())
  userId     String      @map("user_id")
  label      String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String      @map("postal_code")
  country    String      @db.Char(2)
  phone      String?
  type       AddressType @default(SHIPPING)
  isDefault  Boolean     @default(false) @map("is_default")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  logoUrl     String?  @map("logo_url")
  websiteUrl  String?  @map("website_url")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?  @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String        @id @default(cuid())
  brandId     String        @map("brand_id")
  categoryId  String        @map("category_id")
  type        ProductType
  name        String
  slug        String        @unique
  description String?
  status      ProductStatus @default(DRAFT)
  isFeatured  Boolean       @default(false) @map("is_featured")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  brand    Brand            @relation(fields: [brandId], references: [id])
  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
  assets3d Product3DAsset[]
  reviews  Review[]

  cpu         Cpu?
  gpu         Gpu?
  motherboard Motherboard?
  ram         Ram?
  storage     StorageDrive?
  psu         Psu?
  pcCase      PcCase?
  cooler      Cooler?

  buildItems  PCBuildItem[]
  bundleItems BundleItem[]

  @@index([brandId])
  @@index([categoryId])
  @@index([type, status])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  sku            String   @unique
  name           String?
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  currency       String   @default("USD") @db.Char(3)
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  weightGrams    Int?     @map("weight_grams")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    Inventory?
  cartItems    CartItem[]
  wishlistItems WishlistItem[]
  orderItems   OrderItem[]
  buildItems   PCBuildItem[]
  bundleItems  BundleItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  url       String
  alt       String?
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Product3DAsset {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  glbUrl    String   @map("glb_url")
  dracoUrl  String?  @map("draco_url")
  posterUrl String?  @map("poster_url")
  label     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_3d_assets")
}

// ─── Hardware (typed specs, 1:1 with Product) ─────────────────────────────────

model Cpu {
  id              String  @id @default(cuid())
  productId       String  @unique @map("product_id")
  socket          String
  cores           Int
  threads         Int
  baseClockGhz    Decimal @map("base_clock_ghz") @db.Decimal(4, 2)
  boostClockGhz   Decimal @map("boost_clock_ghz") @db.Decimal(4, 2)
  tdpWatts        Int     @map("tdp_watts")
  memoryType      String  @map("memory_type")
  maxMemoryGhz    Int?    @map("max_memory_ghz")
  hasIntegratedGpu Boolean @default(false) @map("has_integrated_gpu")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([socket])
  @@index([memoryType])
  @@map("cpus")
}

model Gpu {
  id              String  @id @default(cuid())
  productId       String  @unique @map("product_id")
  chipset         String
  lengthMm        Int     @map("length_mm")
  slotWidth       Decimal @default(2) @map("slot_width") @db.Decimal(3, 1)
  tdpWatts        Int     @map("tdp_watts")
  recommendedPsuWatts Int? @map("recommended_psu_watts")
  vramGb          Int     @map("vram_gb")
  powerConnectors String  @map("power_connectors")
  interfaceBus    String  @default("PCIe 4.0 x16") @map("interface_bus")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([lengthMm])
  @@map("gpus")
}

model Motherboard {
  id              String  @id @default(cuid())
  productId       String  @unique @map("product_id")
  socket          String
  chipset         String
  formFactor      String  @map("form_factor")
  memoryType      String  @map("memory_type")
  memorySlots     Int     @map("memory_slots")
  maxMemoryGb     Int     @map("max_memory_gb")
  maxMemorySpeedMhz Int?  @map("max_memory_speed_mhz")
  m2Slots         Int     @default(0) @map("m2_slots")
  sataPorts       Int     @default(0) @map("sata_ports")
  wifi            Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([socket, memoryType])
  @@index([formFactor])
  @@map("motherboards")
}

model Ram {
  id           String @id @default(cuid())
  productId    String @unique @map("product_id")
  memoryType   String @map("memory_type")
  speedMhz     Int    @map("speed_mhz")
  capacityGb   Int    @map("capacity_gb")
  modules      Int    @default(2)
  voltage      Decimal? @db.Decimal(3, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([memoryType, speedMhz])
  @@map("ram_kits")
}

model StorageDrive {
  id          String           @id @default(cuid())
  productId   String           @unique @map("product_id")
  interface   StorageInterface
  capacityGb  Int              @map("capacity_gb")
  formFactor  String           @map("form_factor")
  readMbps    Int?             @map("read_mbps")
  writeMbps   Int?             @map("write_mbps")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([interface])
  @@map("storage_drives")
}

model Psu {
  id           String  @id @default(cuid())
  productId    String  @unique @map("product_id")
  wattage      Int
  formFactor   String  @map("form_factor")
  efficiency   String
  modular      String
  lengthMm     Int?    @map("length_mm")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([wattage])
  @@map("psus")
}

model PcCase {
  id                String   @id @default(cuid())
  productId         String   @unique @map("product_id")
  supportedFormFactors String[] @map("supported_form_factors")
  maxGpuLengthMm    Int      @map("max_gpu_length_mm")
  maxCoolerHeightMm Int      @map("max_cooler_height_mm")
  psuFormFactor     String   @map("psu_form_factor")
  maxRadiatorMm     Int?     @map("max_radiator_mm")
  includedFans      Int      @default(0) @map("included_fans")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("pc_cases")
}

model Cooler {
  id              String     @id @default(cuid())
  productId       String     @unique @map("product_id")
  coolerType      CoolerType @map("cooler_type")
  supportedSockets String[]  @map("supported_sockets")
  heightMm        Int?       @map("height_mm")
  radiatorMm      Int?       @map("radiator_mm")
  tdpRatingWatts  Int?       @map("tdp_rating_watts")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("coolers")
}

// ─── Builder & compatibility ─────────────────────────────────────────────────

model CompatibilityRule {
  id          String                 @id @default(cuid())
  code        String                 @unique
  name        String
  description String?
  severity    CompatibilitySeverity  @default(ERROR)
  enabled     Boolean                @default(true)
  /// Optional metadata for admin tooling; engine logic stays in server code.
  config      Json?
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  @@map("compatibility_rules")
}

model PCBuild {
  id                 String          @id @default(cuid())
  userId             String?         @map("user_id")
  name               String
  slug               String?         @unique
  notes              String?
  visibility         BuildVisibility @default(PRIVATE)
  /// Last server-computed price snapshot (display only; never trust from client).
  totalPriceSnapshot Decimal?        @map("total_price_snapshot") @db.Decimal(12, 2)
  currency           String          @default("USD") @db.Char(3)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  user  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items PCBuildItem[]

  @@index([userId])
  @@map("pc_builds")
}

model PCBuildItem {
  id        String        @id @default(cuid())
  buildId   String        @map("build_id")
  productId String        @map("product_id")
  variantId String?       @map("variant_id")
  slot      ComponentSlot
  quantity  Int           @default(1)
  createdAt DateTime      @default(now()) @map("created_at")

  build   PCBuild         @relation(fields: [buildId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([buildId, slot, productId])
  @@index([buildId])
  @@map("pc_build_items")
}

// ─── Performance / benchmarks ────────────────────────────────────────────────

model Game {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  coverUrl  String?  @map("cover_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  benchmarks Benchmark[]

  @@map("games")
}

model Benchmark {
  id          String          @id @default(cuid())
  gameId      String          @map("game_id")
  /// Catalog product IDs used for the estimate (CPU + GPU).
  cpuProductId String         @map("cpu_product_id")
  gpuProductId String         @map("gpu_product_id")
  resolution  String
  quality     GraphicsQuality
  avgFps      Decimal         @map("avg_fps") @db.Decimal(7, 2)
  source      String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, cpuProductId, gpuProductId, resolution, quality])
  @@index([cpuProductId, gpuProductId])
  @@map("benchmarks")
}

// ─── Commerce ────────────────────────────────────────────────────────────────

model Cart {
  id              String    @id @default(cuid())
  userId          String?   @unique @map("user_id")
  sessionId       String?   @unique @map("session_id")
  couponCode      String?   @map("coupon_code")
  lastActivityAt  DateTime  @default(now()) @map("last_activity_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CartItem[]
  abandonedCarts AbandonedCart[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String   @map("cart_id")
  variantId String   @map("variant_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String   @map("wishlist_id")
  variantId  String   @map("variant_id")
  createdAt  DateTime @default(now()) @map("created_at")

  wishlist Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([wishlistId, variantId])
  @@map("wishlist_items")
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType
  /// Percentage (0–100) or fixed currency amount depending on type.
  value           Decimal    @db.Decimal(12, 2)
  minSubtotal     Decimal?   @map("min_subtotal") @db.Decimal(12, 2)
  maxDiscount     Decimal?   @map("max_discount") @db.Decimal(12, 2)
  maxUses         Int?       @map("max_uses")
  maxUsesPerUser  Int?       @map("max_uses_per_user")
  startsAt        DateTime?  @map("starts_at")
  endsAt          DateTime?  @map("ends_at")
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  usages CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String   @map("coupon_id")
  userId    String   @map("user_id")
  orderId   String?  @unique @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([couponId, userId])
  @@map("coupon_usages")
}

model Bundle {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  status      ProductStatus @default(DRAFT)
  /// Optional fixed bundle price; otherwise sum of variants at checkout time (server).
  bundlePrice Decimal?      @map("bundle_price") @db.Decimal(12, 2)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  items BundleItem[]

  @@map("bundles")
}

model BundleItem {
  id        String @id @default(cuid())
  bundleId  String @map("bundle_id")
  productId String @map("product_id")
  variantId String @map("variant_id")
  quantity  Int    @default(1)

  bundle  Bundle         @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([bundleId, variantId])
  @@map("bundle_items")
}

model Order {
  id               String      @id @default(cuid())
  userId           String      @map("user_id")
  orderNumber      String      @unique @map("order_number")
  status           OrderStatus @default(PENDING_PAYMENT)
  currency         String      @default("USD") @db.Char(3)
  subtotal         Decimal     @db.Decimal(12, 2)
  discountTotal    Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  shippingTotal    Decimal     @default(0) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal         Decimal     @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal       Decimal     @map("grand_total") @db.Decimal(12, 2)
  couponCode       String?     @map("coupon_code")
  /// Shipping address snapshot at checkout (immutable history).
  shipName         String      @map("ship_name")
  shipLine1        String      @map("ship_line1")
  shipLine2        String?     @map("ship_line2")
  shipCity         String      @map("ship_city")
  shipState        String?     @map("ship_state")
  shipPostalCode   String      @map("ship_postal_code")
  shipCountry      String      @map("ship_country") @db.Char(2)
  shipPhone        String?     @map("ship_phone")
  paidAt           DateTime?   @map("paid_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]
  couponUsage CouponUsage?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String  @map("order_id")
  variantId   String  @map("variant_id")
  productName String  @map("product_name")
  sku         String
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                    String          @id @default(cuid())
  orderId               String          @map("order_id")
  provider              PaymentProvider @default(STRIPE)
  status                PaymentStatus   @default(REQUIRES_PAYMENT)
  amount                Decimal         @db.Decimal(12, 2)
  currency              String          @default("USD") @db.Char(3)
  stripeSessionId       String?         @unique @map("stripe_session_id")
  stripePaymentIntentId String?         @unique @map("stripe_payment_intent_id")
  rawEventId            String?         @map("raw_event_id")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id             String       @id @default(cuid())
  paymentId      String       @map("payment_id")
  amount         Decimal      @db.Decimal(12, 2)
  status         RefundStatus @default(PENDING)
  reason         String?
  stripeRefundId String?      @unique @map("stripe_refund_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("refunds")
}

// ─── Reviews ─────────────────────────────────────────────────────────────────

model Review {
  id        String       @id @default(cuid())
  productId String       @map("product_id")
  userId    String       @map("user_id")
  rating    Int
  title     String?
  body      String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  images  ReviewImage[]

  @@unique([productId, userId])
  @@index([productId, status])
  @@map("reviews")
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String   @map("review_id")
  url       String
  alt       String?
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_images")
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model Inventory {
  id                 String   @id @default(cuid())
  variantId          String   @unique @map("variant_id")
  quantityOnHand     Int      @default(0) @map("quantity_on_hand")
  quantityReserved   Int      @default(0) @map("quantity_reserved")
  lowStockThreshold  Int      @default(5) @map("low_stock_threshold")
  updatedAt          DateTime @updatedAt @map("updated_at")

  variant      ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@map("inventory")
}

model InventoryTransaction {
  id          String           @id @default(cuid())
  inventoryId String           @map("inventory_id")
  type        InventoryTxnType
  quantityDelta Int            @map("quantity_delta")
  reason      String?
  orderId     String?          @map("order_id")
  actorUserId String?          @map("actor_user_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  actor     User?     @relation("InventoryTxnActor", fields: [actorUserId], references: [id])

  @@index([inventoryId])
  @@map("inventory_transactions")
}

// ─── Marketing ───────────────────────────────────────────────────────────────

model AbandonedCart {
  id             String              @id @default(cuid())
  cartId         String              @map("cart_id")
  userId         String?             @map("user_id")
  email          String?
  status         AbandonedCartStatus @default(ACTIVE)
  lastActivityAt DateTime            @map("last_activity_at")
  recoveredAt    DateTime?           @map("recovered_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  cart   Cart                 @relation(fields: [cartId], references: [id], onDelete: Cascade)
  user   User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  emails AbandonedCartEmail[]

  @@index([status, lastActivityAt])
  @@map("abandoned_carts")
}

model AbandonedCartEmail {
  id              String    @id @default(cuid())
  abandonedCartId String    @map("abandoned_cart_id")
  templateKey     String    @map("template_key")
  sentAt          DateTime  @default(now()) @map("sent_at")
  clickedAt       DateTime? @map("clicked_at")
  recoveredAt     DateTime? @map("recovered_at")

  abandonedCart AbandonedCart @relation(fields: [abandonedCartId], references: [id], onDelete: Cascade)

  @@index([abandonedCartId])
  @@map("abandoned_cart_emails")
}

// ─── System ──────────────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  userId    String              @map("user_id")
  channel   NotificationChannel @default(IN_APP)
  type      String
  title     String
  body      String?
  readAt    DateTime?           @map("read_at")
  metadata  Json?
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}
