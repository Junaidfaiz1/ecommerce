{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vorqen/web", "dev"],
      "port": 3000
    },
    {
      "name": "web-nodb",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vorqen/web", "dev"],
      "env": { "DATABASE_URL": "postgresql://preview:preview@127.0.0.1:1/preview" },
      "port": 3000
    }
  ]
}
