# Copy to `.env` for local development. Never commit real secrets.

# --- Database (Neon recommended — no Docker) ---
# Paste your Neon connection string, or a native local Postgres URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GRAPHQL_URL="http://localhost:3000/api/graphql"
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` (minimum 16 characters).
CRON_SECRET="change-me-cron-secret-min16"

# --- Auth (Phase 4) ---
JWT_SECRET="change-me-access-secret-min-32-chars!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars!"

# --- Stripe (Phase 11) ---
# Dashboard: https://dashboard.stripe.com/test/apikeys
# Local webhook: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Events: payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Cloudflare R2 (Phase 9+) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Resend (Phase 14) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="VORQEN <onboarding@resend.dev>"

# --- Sentry ---
SENTRY_DSN=
